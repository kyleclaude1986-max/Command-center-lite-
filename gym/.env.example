# Copy to .env.local for development, or .env.production on the VPS.
# Generate every secret on the machine that will use it. Never paste one into chat.

# --- Core -------------------------------------------------------------------

# Public URL the app is served from.
NEXTAUTH_URL=https://gym.example.com

# Session signing key. Generate with: npm run gen-secret
NEXTAUTH_SECRET=

# The only account allowed to sign in.
AUTH_ALLOWED_EMAIL=you@example.com

# bcrypt hash of the password. Generate with: npm run hash-password -- 'your-password'
# A valid hash starts with $2b$12$ and is exactly 60 characters.
AUTH_PASSWORD_HASH=

# --- Storage ----------------------------------------------------------------

# SQLite file. On the VPS use an absolute path outside the repo.
SQLITE_PATH=./data/gym.sqlite

# Progress photos, encrypted at rest. Must sit outside the web root.
PHOTO_DIR=./data/photos

# 32 bytes, base64 or hex. Generate with: npm run gen-secret
# Do NOT reuse the Command Center key. Losing this makes existing photos unreadable.
ENCRYPTION_KEY=

DISPLAY_TIMEZONE=America/Chicago

# --- Apple Health -----------------------------------------------------------

# Bearer token the Health Auto Export iPhone app sends with each POST.
# Generate with: npm run gen-secret
HEALTH_INGEST_TOKEN=

# --- iCloud calendar --------------------------------------------------------

# Apple ID, plus an app-specific password from appleid.apple.com.
# This is NOT your regular Apple ID password.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# Exact display name of the calendar workouts are written to.
# Create it yourself in the Calendar app on your iPhone first.
ICLOUD_WORKOUT_CALENDAR_NAME=Workouts

# --- Food databases ---------------------------------------------------------

# Free key from https://fdc.nal.usda.gov/api-key-signup.html
# Optional. Without it, food search falls back to Open Food Facts only.
USDA_FDC_API_KEY=

# Open Food Facts asks that clients identify themselves or they rate-limit.
OFF_USER_AGENT=ZDesignGymTracker/0.1 (personal use)

# --- Scheduler --------------------------------------------------------------

# Calendar scan and pending-write retry.
SYNC_CRON=*/30 * * * *

# Set to 1 to keep the cron from starting (useful for scripts and CI).
DISABLE_SCHEDULER=
