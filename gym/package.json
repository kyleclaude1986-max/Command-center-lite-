{
  "name": "gym-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Kyle's personal gym tracker — workouts, goals, body composition, and food.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "verify": "SQLITE_PATH=./data/verify.sqlite DISABLE_SCHEDULER=1 tsx scripts/verify.ts",
    "db:studio": "drizzle-kit studio",
    "hash-password": "tsx scripts/hash-password.ts",
    "gen-secret": "tsx scripts/gen-secret.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.2",
    "ical.js": "^2.1.0",
    "next": "15.5.15",
    "next-auth": "^4.24.11",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tsdav": "^2.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
