# ------------------------------------------------------------------
# Command Center — environment variables
# Copy to .env.production on the VPS (chmod 600). Never commit .env*.
# ------------------------------------------------------------------

# --- App ---
NODE_ENV=production
# Public base URL of your deployed command center (used by NextAuth)
NEXTAUTH_URL=https://command.example.com
# Random 32+ char string — generate with: openssl rand -base64 48
NEXTAUTH_SECRET=replace-me

# --- Auth (single-user allow-list) ---
AUTH_ALLOWED_EMAIL=kyle@example.com
# bcrypt hash — generate with: npm run hash-password -- 'your password'
#
# IMPORTANT: escape every dollar sign as \$ — the command prints a ready-to-paste
# line that already does this. A bare $ in a .env file is read as a variable
# reference, so an unescaped 60-character hash silently arrives as 53 characters
# with its $2b$12$ prefix stripped, and every sign-in fails with no useful error.
#
# Correct:   AUTH_PASSWORD_HASH=\$2a\$12\$replace.me
# Broken:    AUTH_PASSWORD_HASH=$2a$12$replace.me
AUTH_PASSWORD_HASH=\$2a\$12\$replace.me

# --- Local DB ---
# Absolute path to the SQLite file. Ensure its parent dir exists.
SQLITE_PATH=/var/lib/command-center/data/app.sqlite

# --- Token encryption (AES-256-GCM) ---
# 32-byte key, base64 — generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me

# --- Time zone ---
DISPLAY_TIMEZONE=America/Chicago

# --- Microsoft 365 / Graph (2 work calendars) ---
# Register an app in Entra ID; redirect URI: {NEXTAUTH_URL}/api/integrations/msgraph/callback
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- iCloud CalDAV (2 family calendars) ---
# Apple ID + app-specific password (https://appleid.apple.com)
ICLOUD_A_USERNAME=
ICLOUD_A_APP_PASSWORD=
ICLOUD_A_LABEL=Family A
# Optional: calendar display name to select (e.g., "Family"). Leave blank to pick all.
ICLOUD_A_CALENDAR_NAME=

ICLOUD_B_USERNAME=
ICLOUD_B_APP_PASSWORD=
ICLOUD_B_LABEL=Family B
ICLOUD_B_CALENDAR_NAME=

# --- Bloom Growth ---
BLOOM_BASE_URL=https://app.bloomgrowth.com
BLOOM_API_KEY=
BLOOM_USER_ID=

# --- NetSuite (Token-Based Authentication) ---
# Account ID is the prefix on your NetSuite URL, e.g. "1234567" or "1234567_SB1"
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_KEY=
NETSUITE_TOKEN_SECRET=
# Optional scoping — leave blank if not multi-subsidiary
NETSUITE_SUBSIDIARY_ID=
NETSUITE_DEPARTMENT_ID=

# --- Sync ---
# cron expression; default every 15 min on the quarter hour
SYNC_CRON=*/15 * * * *
